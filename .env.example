# Database connection (SQLite default for zero-setup demo, easily switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Authentication
# REQUIRED in production — failure to set halts startup with a fatal security error.
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_64_character_hex_key_for_production"

# Google Gemini API Key (Optional)
# If provided, CampusIQ utilizes live Gemini for copilot responses, complaint classification,
# and natural language analytics. If omitted, CampusIQ runs in deterministic offline demo mode.
GEMINI_API_KEY=""

# LLM Re-Ranking for RAG Retrieval (Optional, disabled by default)
# Enable ONLY if Gemini API quota is sufficient. Disabled by default to preserve
# free-tier rate limits during live demos.
ENABLE_LLM_RERANKING="false"

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="CampusIQ"
NEXT_PUBLIC_APP_TAGLINE="One Intelligent Layer for the Entire University"
