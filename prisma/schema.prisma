generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  password     String
  name         String
  role         String          // STUDENT, FACULTY, ADMIN
  department   String?
  avatar       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  student      StudentProfile?
  faculty      FacultyProfile?
  notifications Notification[]
  auditLogs    AuditLog[]
}

model StudentProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber     String          @unique
  semester       Int             @default(4)
  department     String
  gpa            Float           @default(3.65)
  academicStatus String          @default("Good Standing")
  mentorName     String?

  attendances    Attendance[]
  assessments    Assessment[]
  insights       LearningInsight[]
  alerts         AcademicAlert[]
  complaints     Complaint[]
}

model FacultyProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String          @unique
  department     String
  designation    String          @default("Assistant Professor")
  officeLocation String?
  courses        Course[]
}

model Course {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  department  String
  semester    Int
  credits     Int            @default(4)
  facultyId   String?
  faculty     FacultyProfile? @relation(fields: [facultyId], references: [id])
  
  attendances Attendance[]
  assessments Assessment[]
}

model Attendance {
  id              String         @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  totalClasses    Int            @default(40)
  attendedClasses Int            @default(35)
  percentage      Float          @default(87.5)
  lastUpdated     DateTime       @default(now())

  @@index([studentId, courseId])
}

model Assessment {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        String         // QUIZ, MIDTERM, FINAL, ASSIGNMENT
  title       String
  score       Float
  maxScore    Float          @default(100)
  topic       String?
  feedback    String?
  date        DateTime       @default(now())
}

model LearningInsight {
  id                String         @id @default(uuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject           String
  topic             String
  status            String         // STRONG, MODERATE, NEEDS_ATTENTION
  explainableReason String
  recommendedAction String
  createdAt         DateTime       @default(now())
}

model AcademicAlert {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String         // LOW_ATTENDANCE, PERFORMANCE_DROP, LEARNING_GAP, DEADLINE
  severity    String         // LOW, MEDIUM, HIGH
  message     String
  isResolved  Boolean        @default(false)
  createdAt   DateTime       @default(now())
}

model ComplaintCategory {
  id                String    @id @default(uuid())
  name              String    @unique
  description       String
  defaultDepartment String
  defaultPriority   String    @default("MEDIUM")
  isActive          Boolean   @default(true)
}

model Complaint {
  id               String                  @id @default(uuid())
  ticketNumber     String                  @unique
  studentId        String
  student          StudentProfile          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName      String
  title            String
  description      String
  category         String
  subcategory      String?
  priority         String                  // LOW, MEDIUM, HIGH, CRITICAL
  department       String
  status           String                  @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, IN_PROGRESS, RESOLVED, CLOSED
  location         String?
  aiSummary        String?
  aiPriorityReason String?
  assignedTo       String?
  resolutionNote   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  statusHistory    ComplaintStatusHistory[]

  @@index([department, status])
}

model ComplaintStatusHistory {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedBy   String
  note        String?
  createdAt   DateTime  @default(now())
}

model Notice {
  id          String    @id @default(uuid())
  title       String
  content     String
  category    String    // ACADEMIC, HOSTEL, EXAM, GENERAL, EVENT
  targetRole  String    @default("ALL") // ALL, STUDENT, FACULTY
  department  String?
  isImportant Boolean   @default(false)
  isArchived  Boolean   @default(false)
  publishedAt DateTime  @default(now())
  authorName  String    @default("Administration")
}

model KnowledgeDocument {
  id               String          @id @default(uuid())
  title            String
  fileName         String
  fileType         String          // PDF, DOCX, TXT, POLICY
  department       String          @default("General Administration")
  category         String          // Academic, Hostel, Examination, IT, Discipline
  fileSize         Int             @default(0)
  processingStatus String          @default("PROCESSED") // PROCESSED, PROCESSING, FAILED
  chunkCount       Int             @default(0)
  summary          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  chunks           DocumentChunk[]
}

model DocumentChunk {
  id            String            @id @default(uuid())
  documentId    String
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex    Int
  content       String
  pageNumber    Int               @default(1)
  keywords      String?
  embeddingJson String?           // Stored embedding representation
  createdAt     DateTime          @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // COMPLAINT, NOTICE, ACADEMIC, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  role      String?
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
